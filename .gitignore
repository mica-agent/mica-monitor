# Mica per-machine / per-session state — regenerated automatically.
# Kept: .mica/card-classes/, .mica/canvas-back.md, .mica/config.json,
# and .mica/layout.json (so the publisher's curated canvas arrangement
# travels with the repo — receivers can rearrange locally and either
# commit the changes or `git restore .mica/layout.json` to discard).
.mica/chats/
.mica/screenshots/
.mica/metrics/
.mica/cards/
.mica/last-opened

# Qwen-Code auto-backup; not source.
.qwen/settings.json.orig

# Claude Code's local IDE state (user-specific, not the project's).
.claude/

# Generic dev junk
node_modules/
dist/
build/
*.log
.env
.env.local
.DS_Store
